# Copy to .env and adjust. Both settings are optional.

# Where the Vite dev server proxies /api requests (see vite.config.js).
#   http://localhost:8000  -> Django `manage.py runserver`  (default)
#   http://localhost       -> nginx from backend/docker-compose.yml
VITE_API_PROXY_TARGET=http://localhost:8000

# Block explorer used for ballot proof links. The contract runs on chipnet
# (backend/blockchain/src/election.js), so a mainnet explorer will not find
# these transactions.
VITE_EXPLORER_TX_URL=https://chipnet.imaginary.cash/tx/

# Path the frontend calls. Leave as /api so requests stay same-origin and go
# through the proxy above — the backend has no CORS middleware installed, so
# pointing this straight at another origin will fail in the browser.
VITE_API_BASE_URL=/api
