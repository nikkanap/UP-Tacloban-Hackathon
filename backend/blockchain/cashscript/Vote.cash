pragma cashscript ^0.13.0;

// this contract; commitment = candidateId(8 bytes) + count(8 bytes).
contract Vote(bytes20 owner, bytes electionCategory){//, int openTime, int closeTime){
    function castVote(){
        // checks if the election has started already
        //require(tx.time >= openTime);
        console.log('still ongoing election');

        // inputs length
        require(tx.inputs.length == 2);
        require(tx.outputs.length == 1);    
        console.log('valid input and output lengths');

        //input 0 - candidate tally nft (mutable capability - 0x01)
        bytes32 input0TokenCategory, bytes input0Capability = tx.inputs[0].tokenCategory.split(32);
        bytes32 input1TokenCategory, bytes input1Capability = tx.inputs[1].tokenCategory.split(32);
        bytes32 outputTokenCategory, bytes outputCapability = tx.outputs[0].tokenCategory.split(32);

        require(input0TokenCategory == electionCategory);   
        require(input0Capability == 0x01);
        console.log('valid input[0]');

        require(input1TokenCategory == electionCategory);
        require(input1Capability == 0x);
        console.log('valid input[1]');

        require(outputTokenCategory == electionCategory);
        require(outputCapability == 0x01);
        console.log('valid output[0]');

        //read candidate nft
        bytes candidateId, bytes remaining = tx.inputs[0].nftCommitment.split(8);
        bytes candidatePositionId, bytes countBytes = remaining.split(8); // also read the position and count

        // read voter nft
        bytes voterId, bytes votingPositionId = tx.inputs[1].nftCommitment.split(8);
        console.log(voterId); // prevents errors
        require(candidatePositionId == votingPositionId); // check if we're voting for the specific position
        console.log('voter NFT is valid for voting for this position');

        // updating the candidate NFT
        int newCount = int(countBytes) + 1;
        bytes newCommitment = candidateId + candidatePositionId + toPaddedBytes(newCount, 8); // Candidate ID stays exactly the same.

        // validate output tally nft
        require(tx.outputs[0].nftCommitment == newCommitment);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].value == tx.inputs[0].value);
        require(tx.outputs[0].tokenAmount == 0);
    }

    // returning the candidate NFTs to the wallet (one by one)
    function returnCandidateNFTToWallet(sig signature, pubkey pk) {
        // checks if election is closed
        //require(tx.time >= closeTime);
        
        // checks input and output lengths
        require(tx.inputs.length == 1);
        require(tx.outputs.length >= 1);
        console.log('valid input and output lengths');

        // verifies tokenCat output and input are the same
        bytes32 inputTokenCategory, bytes inputCapability = tx.inputs[0].tokenCategory.split(32);
        bytes32 outputTokenCategory, bytes outputCapability = tx.outputs[0].tokenCategory.split(32);
        require(inputCapability == 0x01);
        require(inputTokenCategory == electionCategory);
        console.log('valid input[0]');
        
        require(outputCapability == 0x01);
        require(outputTokenCategory == electionCategory);
        console.log('valid output[0]');

        // checks if owner of wallet and signature
        require(hash160(pk) == owner);
        require(checkSig(signature, pk));
        console.log('valid owner of wallet');

        bytes25 ownerLock = new LockingBytecodeP2PKH(owner);
        bool sendsToOwner = tx.outputs[0].lockingBytecode == ownerLock;
        require(sendsToOwner);
        console.log('sending candidate NFT to owner of wallet');
    }
}